<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>EntityFrameworkCore.PostgreSQL.Extensions</PackageId>
    <Version>0.1.0-preview.6</Version>
    <Authors>Keeyahto</Authors>
    <Description>Typed PostgreSQL row locks, transaction advisory locks, atomic insert-ignore and database time for Entity Framework Core.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Keeyahto/EntityFrameworkCore.PostgreSQL.Extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="[10.0.3,11.0.0)" />
    <PackageReference Include="Npgsql" VersionOverride="[10.0.3,11.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="[10.0.12,11.0.0)" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
